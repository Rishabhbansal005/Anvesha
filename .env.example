# =================================================================
# PROJECT_NAME — Environment Variables Configuration
# SIH 2026 Problem Statement SIH26106
# =================================================================

# Application Mode
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL is the primary database. If offline, SQLite is used as local fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_name_db

# Web Client Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=PROJECT_NAME

# Mobile Client Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Threat Intelligence Enrichment (Optional - graceful fallbacks active if omitted)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SAFE_BROWSING_API_KEY=

# Mobile Push Notifications
FCM_SERVER_KEY=
